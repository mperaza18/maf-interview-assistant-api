{
  "name": "Interview Assistant API",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },

  // API (5001) + Vite dev server (5173)
  "forwardPorts": [5001, 5173],
  "portsAttributes": {
    "5001": { "label": "API (.NET)", "onAutoForward": "notify" },
    "5173": { "label": "Web (Vite)", "onAutoForward": "notify" }
  },

  // Secrets become env vars inside the container — set them in VS Code
  // before "Reopen in Container" (File > Open Remote Settings > Secrets)
  // or export them in your shell before running `devcontainer up`.
  "secrets": {
    "AZURE_OPENAI_ENDPOINT": {
      "description": "Azure OpenAI resource endpoint, e.g. https://<name>.openai.azure.com/"
    },
    "AZURE_OPENAI_DEPLOYMENT": {
      "description": "Azure OpenAI deployment name, e.g. gpt-4o-mini"
    },
    "AZURE_OPENAI_API_KEY": {
      "description": "Azure OpenAI API key (leave empty to use Azure CLI auth instead)"
    }
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-azurefunctions",
        "humao.rest-client"
      ],
      "settings": {
        "dotnet.defaultSolution": "InterviewAssistant.Api.sln",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        }
      }
    }
  }
}
