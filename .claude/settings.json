{
  "permissions": {
    "deny": [
      "Bash(git commit*)"
    ],
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet run*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet test*)",
      "Bash(dotnet new*)",
      "Bash(dotnet sln*)",
      "Bash(dotnet add*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git push*)",
      "Bash(gh repo*)",
      "Bash(gh pr*)",
      "Bash(codex --approval-mode auto-edit *)",
      "Bash(codex --help)",
      "Bash(cat /tmp/codex-step.md)",
      "Bash(npm --prefix src/web test)",
      "Bash(npm --prefix src/web run build)",
      "Bash(npm --prefix src/web run dev)"
    ]
  },
  "mcpServers": {
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
