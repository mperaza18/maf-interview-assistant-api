{
  "permissions": {
    "deny": [
      "Bash(git commit*)"
    ],
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet run*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet test*)",
      "Bash(dotnet new*)",
      "Bash(dotnet sln*)",
      "Bash(dotnet add*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git push*)",
      "Bash(gh repo*)",
      "Bash(gh pr*)",
      "Bash(codex*)",
      "Bash(cat /tmp/codex-step*)",
      "Bash(echo*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(cd src/web*)"
    ]
  },
  "mcpServers": {
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    }
  }
}
